    <!-- Main content and sidebar -->
    <div class="row">

        <!-- Article: products -->
        <article class="col-sm-9">

            <div class="row">

                <div class="col-sm-4 col-xs-6 poly-prod">
                    <div class="panel panel-default">
                        <div class="panel-heading">
                            <h4 class="panel-title">Điện thoại Nokia</h4>
                        </div>
                        <div class="panel-body">
                            <img src="https://cdn-icons-png.flaticon.com/512/644/644458.png"
                                 alt="Điện thoại Nokia">
                        </div>
                        <div class="panel-footer">$100.25</div>
                    </div>
                </div>

                <div class="col-sm-4 col-xs-6 poly-prod">
                    <div class="panel panel-default">
                        <div class="panel-heading">
