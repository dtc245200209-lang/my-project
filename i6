    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js"></script>

    <style>
        body {
            background-color: #f5f5f5;
        }

        .container {
            background-color: white;
        }

        header {
            position: relative;
            height: 200px;
            background: linear-gradient(120deg, #1686a8, #043c62);
            overflow: hidden;
            color: white;
        }

        .shopping-mall {
            position: absolute;
            bottom: 20px;
            left: 25px;
            font-variant: small-caps;
        }

        .shopping-mall h1 {
            font-family: Impact, sans-serif;
            font-size: 40px;
            color: white;
            letter-spacing: 0.3px;
            text-shadow: 0 0 3px black;
            padding-bottom: 8px;
            border-bottom: 1px dotted white;
            margin: 0;
        }

        .shopping-mall h5 {
            margin-top: 8px;
            letter-spacing: 0.5px;
        }

        .header-image {
            position: absolute;
            right: 20px;
            top: 15px;
            width: 160px;
            height: 160px;
            object-fit: contain;
        }

        .navbar {
            margin-bottom: 15px;
            border-radius: 0;
        }

        .poly-cart {
            margin-top: 5px;
        }

        .poly-cart ul {
            padding: 0;
            margin: 0;
            list-style: none;
            font-variant: small-caps;
        }

        .poly-cart .panel-heading strong {
            font-variant: small-caps;
            font-size: larger;
            text-shadow: 0 0 2px darkgray;
        }

        .poly-cart img {
            max-width: 100%;
        }

        .poly-prod {
            text-align: center;
            padding: 5px;
        }

        .poly-prod .panel-body img {
            height: 150px;
            max-width: 95%;
            object-fit: contain;
        }

        .poly-prod .panel {
            height: 240px;
        }

        .poly-prod .panel-footer {
            font-size: 17px;
            font-weight: bold;
            color: #d9534f;
        }

        footer {
            margin-top: 15px;
        }

        @media (max-width: 767px) {
            .shopping-mall {
                left: 15px;
                bottom: 25px;
            }

            .shopping-mall h1 {
                font-size: 27px;
            }

            .shopping-mall h5 {
                font-size: 12px;
