<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Simple Web Development Template</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            line-height: 1.7;
            color: #222;
        }

        /* Thanh điều hướng */
        .navbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background-color: #111;
            padding: 10px 5%;
            position: sticky;
            top: 0;
            z-index: 1000;
            gap: 20px;
        }

        .nav-list {
            display: flex;
            align-items: center;
            list-style: none;
            gap: 25px;
        }

        .logo {
            color: white;
            font-size: 24px;
            font-weight: bold;
            margin-right: 15px;
        }

        .nav-list li a {
            text-decoration: none;
            color: white;
            font-size: 16px;
        }

        .nav-list li a:hover {
            color: #55d6be;
        }

        .rightNav {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        #search {
            width: 150px;
            padding: 8px;
            border: none;
            border-radius: 5px;
        }

        .btn {
            padding: 8px 15px;
            background-color: #159b80;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

        .btn:hover {
            background-color: #10745f;
        }

        /* Phần giới thiệu đầu tiên */
        .firstsection {
            background-color: #d8f3dc;
            padding: 60px 8%;
            min-height: 350px;
            display: flex;
            align-items: center;
        }

        .box-main {
            max-width: 1100px;
            width: 100%;
            margin: auto;
        }

        .firstHalf {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        /* Phần C Programming */
        .secondsection {
            background-color: #dbeafe;
            padding: 60px 8%;
            min-height: 350px;
            display: flex;
            align-items: center;
        }

        .secondHalf {
            max-width: 1100px;
            width: 100%;
            margin: auto;
        }

        /* Phần Java */
        .section {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 40px;
            max-width: 1100px;
            margin: auto;
            padding: 60px 30px;
            min-height: 350px;
        }

        .section-Left {
            flex-direction: row-reverse;
        }

        .paras {
            flex: 1;
        }

        .thumbnail {
            flex: 0 0 35%;
            text-align: center;
        }

        .thumbnail img {
            width: 100%;
            max-width: 320px;
            border-radius: 15px;
            border: 3px solid #ddd;
        }

        .text-big {
            font-size: 32px;
            font-weight: bold;
            margin-bottom: 15px;
            color: #12372a;
        }

        .text-small {
            font-size: 17px;
        }

        .center {
            text-align: center;
        }

        /* Chân trang */
        footer {
            background-color: #111;
            color: white;
            padding: 25px;
            text-align: center;
        }

        /* Giao diện điện thoại */
        @media (max-width: 768px) {
            .navbar {
                flex-direction: column;
                padding: 15px;
            }

            .nav-list {
                flex-wrap: wrap;
                justify-content: center;
                gap: 15px;
            }

            .rightNav {
                width: 100%;
                justify-content: center;
            }

            #search {
                width: 65%;
