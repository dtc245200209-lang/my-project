```html
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bố cục 3 cột Bootstrap và Flexbox</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <style>
        body {
            background-color: #f8f9fa;
        }

        .section-title {
            color: #0d6efd;
            margin-bottom: 25px;
            text-align: center;
        }

        .my-column {
            min-height: 150px;
            border-radius: 8px;
        }

        .carousel img {
            height: 400px;
            object-fit: cover;
        }

        .contact-form {
            max-width: 700px;
            margin: auto;
            background-color: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 2px 10px #ddd;
        }

        footer {
            background-color: #212529;
            color: white;
            text-align: center;
            padding: 20px;
            margin-top: 50px;
        }

        @media (max-width: 767px) {
            .carousel img {
                height: 250px;
            }
        }
    </style>
</head>

<body>

    <!-- Thanh điều hướng -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand" href="#">
                <i class="fas fa-home"></i> Trang chủ
            </a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse" data-bs-target="#menu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="menu">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link active" href="#grid">Bố cục</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#carousel">Hình ảnh</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#contact">Liên hệ</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Bước 1: Grid 3 cột và Flexbox -->
    <div class="container mt-5" id="grid">
        <h2 class="section-title">
            <i class="fas fa-columns"></i> Bố cục 3 cột
        </h2>

        <div class="row g-3">
            <div class="col-md-4 d-flex justify-content-center align-items-center
                        bg-light p-3 my-column">
                <p class="mb-0">Phần 1: Nội dung thứ nhất</p>
            </div>

            <div class="col-md-4 d-flex justify-content-center align-items-center
                        bg-secondary p-3 text-white my-column">
                <p class="mb-0">Phần 2: Nội dung thứ hai</p>
            </div>

            <div class="col-md-4 d-flex justify-content-center align-items-center
                        bg-light p-3 my-column">
                <p class="mb-0">Phần 3: Nội dung thứ ba</p>
            </div>
        </div>
    </div>

    <!-- Bước 2: Margin và Padding -->
    <section class="container my-5 py-3">
        <h3 class="text-center">
            Khoảng cách bằng Margin và Padding
        </h3>
        <p class="text-center text-muted">
            Sử dụng my-5 để tạo khoảng cách bên ngoài
            và py-3 để tạo khoảng cách bên trong.
        </p>
    </section>

    <!-- Bước 3: Display Property -->
    <div class="container">
        <div class="d-none d-md-block bg-warning text-center p-3 rounded">
            <p class="mb-0">
                Nội dung này chỉ hiển thị trên màn hình rộng từ 768px trở lên.
            </p>
        </div>
    </div>

    <!-- Bước 4: Carousel -->
    <section class="container mt-5" id="carousel">
        <h2 class="section-title">
            <i class="fas fa-images"></i> Thư viện hình ảnh
        </h2>

        <div id="myCarousel" class="carousel slide" data-bs-ride="carousel">
            <!-- Các nút chỉ báo -->
            <div class="carousel-indicators">
                <button type="button" data-bs-target="#myCarousel"
                        data-bs-slide-to="0" class="active"
                        aria-current="true" aria-label="Hình 1"></button>
                <button type="button" data-bs-target="#myCarousel"
                        data-bs-slide-to="1" aria-label="Hình 2"></button>
                <button type="button" data-bs-target="#myCarousel"
                        data-bs-slide-to="2" aria-label="Hình 3"></button>
            </div>

            <!-- Nội dung Carousel -->
            <div class="carousel-inner rounded">
                <div class="carousel-item active">
                    <img src="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?w=1200"
                         class="d-block w-100" alt="Phong cảnh thiên nhiên">
                    <div class="carousel-caption">
                        <h5>Thiên nhiên tươi đẹp</h5>
                    </div>
                </div>

                <div class="carousel-item">
                    <img src="https://images.unsplash.com/photo-1470770841072-f978cf4d019e?w=1200"
                         class="d-block w-100" alt="Hồ nước và núi">
                    <div class="carousel-caption">
                        <h5>Khám phá thế giới</h5>
                    </div>
                </div>

                <div class="carousel-item">
                    <img src="https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=1200"
                         class="d-block w-100" alt="Rừng xanh">
                    <div class="carousel-caption">
                        <h5>Vẻ đẹp của rừng xanh</h5>
                    </div>
                </div>
            </div>

            <!-- Nút chuyển ảnh -->
            <button class="carousel-control-prev" type="button"
                    data-bs-target="#myCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon"
                      aria-hidden="true"></span>
                <span class="visually-hidden">Ảnh trước</span>
            </button>

            <button class="carousel-control-next" type="button"
                    data-bs-target="#myCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon"
                      aria-hidden="true"></span>
                <span class="visually-hidden">Ảnh tiếp theo</span>
            </button>
        </div>
    </section>

    <!-- Bước 5: Font Awesome -->
    <section class="container my-5">
        <h2 class="section-title">Các biểu tượng Font Awesome</h2>

        <div class="row text-center g-3">
            <div class="col-md-4">
                <i class="fas fa-home fa-3x text-primary"></i>
                <p class="mt-2">Trang chủ</p>
            </div>

            <div class="col-md-4">
                <i class="fas fa-envelope fa-3x text-success"></i>
                <p class="mt-2">Email</p>
            </div>

            <div class="col-md-4">
                <i class="fas fa-paper-plane fa-3x text-danger"></i>
                <p class="mt-2">Gửi thông tin</p>
            </div>
        </div>
    </section>

    <!-- Bước 6: Form liên hệ -->
    <section class="container my-5" id="contact">
        <h2 class="section-title">
            <i class="fas fa-envelope"></i> Form liên hệ
        </h2>

        <form class="contact-form" id="contactForm">
            <div class="mb-3">
                <label for="name" class="form-label">Họ và tên</label>
                <input type="text" class="form-control" id="name"
                       placeholder="Nhập họ và tên" required>
            </div>

            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input type="email" class="form-control" id="email"
                       placeholder="Nhập email" required>
            </div>

            <div class="mb-3">
                <label for="message" class="form-label">Nội dung</label>
                <textarea class="form-control" id="message" rows="4"
                          placeholder="Nhập nội dung" required></textarea>
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="fas fa-paper-plane"></i> Gửi
            </button>
        </form>
    </section>

    <!-- Footer -->
    <footer>
        <p class="mb-2">Bài thực hành Bootstrap Grid và Flexbox</p>
        <p class="mb-0">
            <i class="fab fa-facebook"></i>
            <i class="fab fa-instagram mx-3"></i>
            <i class="fab fa-github"></i>
        </p>
    </footer>

    <!-- Bootstrap JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Xử lý Form -->
    <script>
        document.getElementById("contactForm").addEventListener("submit", function(event) {
            event.preventDefault();

            alert("Bạn đã gửi thông tin thành công!");
            this.reset();
        });
    </script>

</body>
</html>
```
