.grid1 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-gap: 20px;
    margin-bottom: 30px;
}

.grid2 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-gap: 30px 10px;
}

.grid1 div {
    background-color: lightblue;
    padding: 20px;
    text-align: center;
}

.grid2 div {
    background-color: lightgreen;
    padding: 20px;
    text-align: center;
}
