```html
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bootstrap Navbar</title>

    <!-- Nhúng Bootstrap CSS -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
        }

        .welcome {
            text-align: center;
            padding: 80px 20px;
        }

        .welcome h1 {
            color: #212529;
            margin-bottom: 20px;
        }

        .welcome p {
            color: #666;
            font-size: 18px;
        }
    </style>
</head>

<body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">

            <!-- Logo -->
            <a class="navbar-brand fw-bold" href="#">MyWebsite</a>

            <!-- Nút menu trên mobile -->
            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav"
                    aria-controls="navbarNav"
                    aria-expanded="false"
                    aria-label="Mở menu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Menu điều hướng -->
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link active" href="#home">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#about">About</a>
                    </li>

                    <!-- Menu dropdown -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle"
                           href="#"
                           role="button"
                           data-bs-toggle="dropdown"
                           aria-expanded="false">
                            Services
                        </a>

                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item" href="#web-design">
                                    Web Design
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="#seo">
                                    SEO
                                </a>
                            </li>
                        </ul>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#contact">Contact</a>
                    </li>

                </ul>
            </div>

        </div>
    </nav>

    <!-- Nội dung trang web -->
    <main class="welcome" id="home">
        <h1>Welcome to MyWebsite!</h1>
        <p>Thực hành tạo thanh điều hướng bằng Bootstrap 5.</p>
        <a href="#about" class="btn btn-primary">Tìm hiểu thêm</a>
    </main>

    <section class="container pb-5" id="about">
        <h2>About</h2>
        <p>Đây là khu vực giới thiệu website.</p>
    </section>

    <section class="container pb-5" id="web-design">
        <h2>Web Design</h2>
        <p>Dịch vụ thiết kế giao diện website.</p>
    </section>

    <section class="container pb-5" id="seo">
        <h2>SEO</h2>
        <p>Dịch vụ tối ưu hóa công cụ tìm kiếm.</p>
    </section>

    <footer class="bg-dark text-white text-center p-3" id="contact">
        <p class="mb-0">© 2026 MyWebsite - Bootstrap Navbar</p>
    </footer>

    <!-- Nhúng Bootstrap JavaScript để dropdown và menu mobile hoạt động -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
